// Prisma Schema for Viral Shorts Dashboard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Video {
  id            String   @id @default(cuid())
  platform      Platform
  videoId       String   @unique
  title         String
  description   String?
  thumbnailUrl  String
  videoUrl      String
  authorName    String?
  authorUrl     String?

  // Statistics
  viewCount     BigInt   @default(0)
  likeCount     BigInt   @default(0)
  shareCount    BigInt   @default(0)
  commentCount  BigInt   @default(0)

  // Viral tracking
  viewCountHistory Json   @default("[]") // [{date, count}, ...]
  viralScore       Float  @default(0)    // Growth rate score

  // Classification
  category      Category?
  targetAge     String?   // "10s", "20s", "30s", etc.
  tags          String[]
  country       String?   // "KR", "US", "JP", "Global" etc.

  // Metadata
  publishedAt   DateTime?
  collectedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Seller-validation signals (creator profile + comment intent)
  hasPurchaseIntent    Boolean @default(false)
  purchaseIntentScore  Int     @default(0)  // 0-100, 상위 20 댓글 중 구매 의도 비율
  passReason           String?              // "creator_link" | "comment_intent" | "both"
  visualClass          String?              // "product" | "face" | "mixed" — Gemini Vision 분석 결과

  @@index([platform])
  @@index([category])
  @@index([country])
  @@index([viralScore(sort: Desc)])
  @@index([collectedAt(sort: Desc)])
  @@index([hasPurchaseIntent])
}

model Creator {
  id            String   @id @default(cuid())
  platform      Platform
  authorId      String   // tiktok unique_id, youtube channelId, ig username
  authorName    String?
  bioUrl        String?
  signature     String?  // tiktok signature / ig biography / yt channel description (앞 500자)
  hasSalesLink  Boolean  @default(false)
  followerCount Int?
  videoCount    Int?
  lastCheckedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([platform, authorId])
  @@index([hasSalesLink])
  @@index([lastCheckedAt])
}

enum Platform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
}

enum Category {
  BEAUTY
  FOOD
  FASHION
  ELECTRONICS
  LIFESTYLE
  HEALTH
  KIDS
  OTHER
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  name           String?
  role           Role           @default(USER)

  // B2B contact / business profile (유통업자 대상)
  phone          String?
  companyName    String?
  businessNumber String?        // 사업자등록번호 (123-45-67890)

  // Activity tracking
  lastLoginAt    DateTime?
  loginCount     Int            @default(0)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Community profile
  bio            String?
  profileImage   String?        // base64 data URI or URL

  subscriptions  Subscription[]
  activityLogs   ActivityLog[]
  posts          CommunityPost[]
  comments       CommunityComment[]
  postLikes      PostLike[]
  payments       Payment[]

  @@index([email])
}

// ===== 결제 (토스페이먼츠) =====

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String        @unique          // 클라이언트 생성, 토스 승인 시 검증
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int                            // 기대 금액(서버 고정) — 위변조 검증용
  status     PaymentStatus @default(PENDING)
  paymentKey String?                        // 토스 승인 후 발급
  method     String?                        // 카드/간편결제 등
  orderName  String?
  raw        Json?                          // 토스 승인 응답 원본
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

// ===== Community =====

enum CommunityStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

model CommunityPost {
  id         String          @id @default(cuid())
  authorId   String
  author     User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName String                          // 작성 시점 이름 스냅샷
  title      String
  message    String
  image      String?                         // base64 data URI or URL (선택)
  status     CommunityStatus @default(PUBLISHED)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  comments   CommunityComment[]
  likes      PostLike[]

  @@index([status, createdAt(sort: Desc)])
  @@index([authorId])
}

model CommunityComment {
  id        String          @id @default(cuid())
  postId    String
  post      CommunityPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName String
  message   String
  parentId  String?                          // 대댓글이면 부모 댓글 id
  status    CommunityStatus @default(PUBLISHED)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([postId, createdAt])
  @@index([authorId])
}

// 관리자가 직접 추가하는 큐레이션 상품 (정적 SCOPE_PRODUCTS 와 함께 상품목록에 노출)
model CuratedProduct {
  id          String   @id @default(cuid())
  name        String
  category    String   // Fashion | Pet | Home | Beauty | Tech | Outdoor
  description String
  source      String?  // 원본 링크 (선택)
  image       String   // base64 data URI 또는 URL
  score       Int      @default(80)
  trend       Int      @default(80)
  profit      Int      @default(70)
  competition Int      @default(40)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
}

model PostLike {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([postId, userId])   // 유저당 1좋아요
  @@index([userId])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  startAt   DateTime           @default(now())
  endAt     DateTime
  status    SubscriptionStatus @default(ACTIVE)
  amount    Int                @default(100000) // KRW
  memo      String?            // 입금자명 등 어드민 메모
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId])
  @@index([endAt])
  @@index([status])
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // "LOGIN", "SIGNUP", "VIEW_PRODUCT", "SEARCH", ...
  metadata  Json?    // free-form context, e.g. { productId, query }
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}
